# =============================================================================
# Hospital Management System — Backend Environment Variables
# =============================================================================
# Copy to .env for local development:
#   cp .env.example .env
#
# Production: set all values in Render dashboard (Environment tab)
# =============================================================================

# Server port (Render sets PORT automatically — use 5001 for local dev)
PORT=5001

# MongoDB
# Local:  mongodb://localhost:27017/hospital-management
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/hospital-management?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/hospital-management

# JWT signing secret — long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# development | production
NODE_ENV=development

# Comma-separated frontend origins for CORS + Socket.IO
# Development:
FRONTEND_URL=https://shubham-hospital-management.netlify.app
VITE_API_URL=https://hospital-management-system-111.onrender.com
# Production (your Netlify URL):
# FRONTEND_URL=https://your-app.netlify.app
