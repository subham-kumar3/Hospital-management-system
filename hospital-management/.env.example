# =============================================================================
# Frontend Environment Variables (Hospital Management System)
# =============================================================================
#
# Vite auto-loads by command:
#   npm run dev    → .env.development (+ .env)
#   npm run build  → .env.production (+ .env)
#
# Copy this file to .env for local overrides:
#   cp .env.example .env
# =============================================================================

# --- VITE_API_URL ---
# Backend base URL. Do NOT add /api at the end.
#
# Development: leave empty (Vite proxies /api → localhost:5001)
# Production:  your Render URL, e.g. https://hospital-api.onrender.com
# Netlify:      set in Dashboard → Site settings → Environment variables
VITE_API_URL=

# --- VITE_DEV_API_URL ---
# Local Express backend for Vite dev-server proxy (development only)
VITE_DEV_API_URL=http://localhost:5001

# --- LAN testing (optional) ---
# VITE_API_URL=http://192.168.1.10:5001
